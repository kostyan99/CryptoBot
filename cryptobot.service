[Unit]
Description=Crypto Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=kostya
WorkingDirectory=/home/orangepi/cryptobot
EnvironmentFile=/home/orangepi/cryptobot/.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/home/orangepi/cryptobot/venv/bin/python bot.py
Restart=always
RestartSec=10
TimeoutStopSec=45
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
