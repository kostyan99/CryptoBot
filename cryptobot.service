[Unit]
Description=Crypto Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=kostya
WorkingDirectory=/home/kostya/CryptoBot
EnvironmentFile=/home/kostya/CryptoBot/.env
# Большие временные буферы (картинки графиков) сразу возвращаются системе: ~150 -> ~70 МБ под нагрузкой
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MALLOC_MMAP_THRESHOLD_=131072
ExecStart=/home/kostya/CryptoBot/venv/bin/python bot.py
Restart=always
RestartSec=10
TimeoutStopSec=45
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
